{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "feedback-lab",
  "main": "src/app.ts",
  "compatibility_date": "2026-11-20",
  "workers_dev": false,
  "preview_urls": false,
  "routes": [
    { "pattern": "python-assessor.akbarsahata.id", "custom_domain": true }
  ],
  "observability": {
    "enabled": true,
    "redact_query_string": true,
    "traces": { "enabled": true }
  },
  "ratelimits": [
    {
      "name": "SIGN_IN_LIMITER",
      "namespace_id": "664741002",
      "simple": { "limit": 12, "period": 60 }
    }
  ],
  // Runs are dispatched as IDs only. The private RUNNER service binding must be
  // configured before a queue message can execute tests.
  "services": [
    { "binding": "RUNNER", "service": "feedback-lab-runner" }
  ],
  "queues": {
    "producers": [
      { "binding": "TEST_RUN_QUEUE", "queue": "feedback-lab-test-runs" }
    ],
    "consumers": [
      {
        "queue": "feedback-lab-test-runs",
        "max_batch_size": 1,
        "max_batch_timeout": 1,
        "max_concurrency": 1,
        "max_retries": 0
      }
    ]
  },
  "triggers": {
    "crons": ["*/5 * * * *"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "feedback-lab",
      "migrations_dir": "migrations"
    }
  ]
}
