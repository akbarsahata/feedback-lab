{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "feedback-lab",
  "main": "src/app.ts",
  "compatibility_date": "2026-11-20",
  "observability": {
    "enabled": true
  },
  "ratelimits": [
    {
      "name": "SIGN_IN_LIMITER",
      "namespace_id": "664741002",
      "simple": { "limit": 12, "period": 60 }
    }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "feedback-lab",
      // Replace with the ID returned by `npx wrangler d1 create feedback-lab`
      // before deploying. Local development ignores this value.
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations"
    }
  ]
}
