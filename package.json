{
  "name": "feedback-lab",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:migrate:local": "wrangler d1 migrations apply feedback-lab --local",
    "db:migrate:remote": "wrangler d1 migrations apply feedback-lab --remote",
    "provision": "node scripts/provision-user.mjs"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "^1.9.2",
    "@cloudflare/workers-types": "^5.20261124.2",
    "@types/node": "^24.0.0",
    "swagger-ui-dist": "5.36.0",
    "typescript": "^5.9.0",
    "vitest": "^5.1.1",
    "wrangler": "^4.168.0"
  },
  "engines": {
    "node": ">=22.14.0"
  },
  "dependencies": {
    "zod": "^4.6.6",
    "zod-openapi": "^6.0.3"
  }
}
